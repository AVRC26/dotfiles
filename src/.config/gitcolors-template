# Git color theme — generated by set-theme, do not edit directly.
# Edit src/.config/gitcolors-template in the dotfiles repo.
# Rendered to ~/.config/git/theme.conf; loaded via [include] in ~/.gitconfig.

[color "diff"]
    meta       = "{{GC_META}} bold"
    frag       = "{{GC_FRAG}} bold"
    old        = "{{GC_OLD}} bold"
    new        = "{{GC_NEW}} bold"
    commit     = "{{GC_BRANCH}}"
    whitespace = "{{GC_OLD}} reverse"

[color "status"]
    added     = "{{GC_ADDED}} bold"
    changed   = "{{GC_CHANGED}}"
    untracked = "{{GC_UNTRACKED}}"
    branch    = "{{GC_BRANCH}} bold"

[color "branch"]
    current  = "{{GC_BRANCH}} bold"
    local    = "{{GC_ADDED}}"
    remote   = "{{GC_REMOTE}}"
    upstream = "{{GC_REMOTE}} bold"

[color "decorate"]
    HEAD         = "{{GC_OLD}} bold"
    branch       = "{{GC_BRANCH}} bold"
    remoteBranch = "{{GC_REMOTE}}"
    tag          = "{{GC_TAG}} bold"
    stash        = "{{GC_FRAG}}"

[color "grep"]
    match      = "{{GC_BRANCH}} bold"
    filename   = "{{GC_ADDED}}"
    linenumber = "{{GC_META}}"

[color "interactive"]
    prompt = "{{GC_BRANCH}} bold"
    header = "{{GC_META}}"
    help   = "{{GC_ADDED}}"
    error  = "{{GC_OLD}} bold"

[delta "theme-colors"]
    syntax-theme                 = {{DELTA_SYNTAX_THEME}}
    plus-style                   = "syntax {{GC_PLUS_BG}}"
    plus-emph-style              = "syntax bold {{GC_PLUS_EMPH_BG}}"
    minus-style                  = "syntax {{GC_MINUS_BG}}"
    minus-emph-style             = "syntax bold {{GC_MINUS_EMPH_BG}}"
    line-numbers-plus-style      = "{{GC_NEW}} bold"
    line-numbers-minus-style     = "{{GC_OLD}} bold"
    line-numbers-zero-style      = "{{GC_META}}"
    line-numbers-left-style      = "{{GC_FRAG}}"
    line-numbers-right-style     = "{{GC_FRAG}}"
    file-style                   = "{{GC_BRANCH}} bold"
    file-decoration-style        = "{{GC_BRANCH}} underline"
    hunk-header-style            = "{{GC_META}} italic"
    hunk-header-decoration-style = "{{GC_FRAG}} box"
